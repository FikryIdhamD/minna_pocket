  "bunkei": [
   {
    "no": 1,
    "jp": "{相撲|すもう}を　{見|み}た　ことが　あります。",
    "tr": "Apakah pernah menonton Sumo?"
   },
   {
    "no": 2,
    "jp": "{休|やす}みの　{日|ひ}は　テニスを　したり、{散歩|さんぽ}に　{行|い}ったり　します。",
    "tr": "Pada hari libur, bermain tenis, dan berjalan-jalan."
   },
   {
    "no": 3,
    "jp": "これから　だんだん　{暑|あつ}く　なります。",
    "tr": "Secara pelelahan-lahan menjadi panas."
   }
  ],
  "reibun": [
   {
    "no": 1,
    "lines": [
     {
      "jp": "{北海道|ほっかいどう}へ　{行|い}った　ことが　ありますか。",
      "tr": "Apakah pernah pergi ke Hokkaido?"
     },
     {
      "jp": "……はい、{一度|いちど}　あります。　2{年|ねん}まえに、{友達|ともだち}と　{行|い}きました。",
      "tr": "……Ya, pernah satu kali. Dua tahun yang lalu, pergi dengan teman."
     }
    ]
   },
   {
    "no": 2,
    "lines": [
     {
      "jp": "{馬|うま}に　{乗|の}った　ことが　ありますか。",
      "tr": "Apakah pernah berkuda?"
     },
     {
      "jp": "……いいえ、{一度|いちど}も　ありません。　ぜひ　{乗|の}りたいです。",
      "tr": "……Belum, belum pernah sama sekali. Ingin sekali berkuda."
     }
    ]
   },
   {
    "no": 3,
    "lines": [
     {
      "jp": "{冬休|ふゆやす}みは　{何|なに}を　しましたか。",
      "tr": "Pada liburan musim dingin melakukan apa?"
     },
     {
      "jp": "……{京都|きょうと}の　お{寺|てら}や　{神社|じんじゃ}を　{見|み}たり、{友達|ともだち}と　パーティーを　したり　しました。",
      "tr": "……Melihat kuil dan wihara di Kyoto, dan berpesta dengan teman."
     }
    ]
   },
   {
    "no": 4,
    "lines": [
     {
      "jp": "{日本|にほん}で　{何|なに}を　したいですか。",
      "tr": "Ingin melakukan apa di Jepang?"
     },
     {
      "jp": "……{旅行|りょこう}したり、お{茶|ちゃ}を　{習|なら}ったり　したいです。",
      "tr": "……Ingin berwisata dan belajar upacara minum teh."
     }
    ]
   },
   {
    "no": 5,
    "lines": [
     {
      "jp": "{体|からだ}の　{調子|ちょうし}は　どうですか。",
      "tr": "Bagaimana kondisi badannya?"
     },
     {
      "jp": "……おかげさまで　よく　なりました。",
      "tr": "……Berkat Anda, sudah sembuh."
     }
    ]
   },
   {
    "no": 6,
    "lines": [
     {
      "jp": "{日本語|にほんご}が　{上手|じょうず}に　なりましたね。",
      "tr": "Sudah pandai berbahasa Jepang, ya."
     },
     {
      "jp": "……ありがとう　ございます。　でも、まだまだです。",
      "tr": "……Terima kasih. Tetapi masih kurang."
     }
    ]
   },
   {
    "no": 7,
    "lines": [
     {
      "jp": "テレーザちゃんは　{何|なに}に　なりたいですか。",
      "tr": "Teresa ingin menjadi apa?"
     },
     {
      "jp": "……{医者|いしゃ}に　なりたいです。",
      "tr": "……Ingin menjadi dokter."
     }
    ]
   }
  ],
  "kaiwa": {
   "title_jp": "ダイエットは　あしたから　します",
   "title_tr": "Dietnya Mulai Besok.",
   "image": "img/L19/kaiwa.webp",
   "audio": "audio/L19_kaiwa.m4a",
   "cd_track": "CD66",
   "lines": [
    {
     "speaker_jp": "{皆|みな}",
     "speaker_tr": "Semuanya",
     "jp": "{乾杯|かんぱい}。",
     "tr": "Toast!"
    },
    {
     "speaker_jp": "{松本良子|まつもとよしこ}",
     "speaker_tr": "Yoshiko Matsumoto",
     "break_before": true,
     "jp": "マリアさん、あまり　{食|た}べませんね。",
     "tr": "Sdr. Maria kurang makan, ya?"
    },
    {
     "speaker_jp": "マリア",
     "speaker_tr": "Maria",
     "jp": "ええ。　きのうから　ダイエットを　して　います。",
     "tr": "Ya. Sejak kemarin saya berdiet."
    },
    {
     "speaker_jp": "{松本良子|まつもとよしこ}",
     "speaker_tr": "Yoshiko Matsumoto",
     "jp": "そうですか。　わたしも　ダイエットを　した　ことが　あります。",
     "tr": "O, begitu. Saya juga pernah berdiet."
    },
    {
     "speaker_jp": "マリア",
     "speaker_tr": "Maria",
     "jp": "どんな　ダイエットですか。",
     "tr": "Cara diet bagaimana?"
    },
    {
     "speaker_jp": "{松本良子|まつもとよしこ}",
     "speaker_tr": "Yoshiko Matsumoto",
     "jp": "{毎日|まいにち}　りんごだけ　{食|た}べたり、{水|みず}を　たくさん　{飲|の}んだり　しました。",
     "tr": "Setiap hari hanya makan buah apel dan minum air yang banyak."
    },
    {
     "jp": "でも、{無理|むり}な　ダイエットは　{体|からだ}に　よくないですね。",
     "tr": "Tetapi, diet yang paksa tidak baik untuk tubuh, ya."
    },
    {
     "speaker_jp": "マリア",
     "speaker_tr": "Maria",
     "jp": "そうですね。",
     "tr": "Ya, betul."
    },
    {
     "speaker_jp": "{松本良子|まつもとよしこ}",
     "speaker_tr": "Yoshiko Matsumoto",
     "jp": "マリアさん、この　アイスクリーム、おいしいですよ。",
     "tr": "Sdr. Maria, es krim ini enak."
    },
    {
     "speaker_jp": "マリア",
     "speaker_tr": "Maria",
     "jp": "そうですか。",
     "tr": "O, ya."
    },
    {
     "jp": "……。　ダイエットは　また　あしたから　します。",
     "tr": "...... Dietnya mulai besok lagi."
    }
   ]
  },
