  "bunkei": [
   {
    "no": 1,
    "jp": "{写真|しゃしん}を　{撮|と}らないで　ください。",
    "tr": "Jangan mengambil foto!"
   },
   {
    "no": 2,
    "jp": "パスポートを　{見|み}せなければ　なりません。",
    "variants_jp": [
     "（{見|み}せないと　いけません）"
    ],
    "tr": "Harus memperlihatkan paspor."
   },
   {
    "no": 3,
    "jp": "{日曜日|にちようび}は　{早|はや}く　{起|お}きなくても　いいです。",
    "tr": "Pada hari Minggu tidak perlu bangun pagi-pagi."
   }
  ],
  "reibun": [
   {
    "no": 1,
    "lines": [
     {
      "jp": "そこに　{車|くるま}を　{止|と}めないで　ください。",
      "tr": "Jangan parkir mobil di situ!"
     },
     {
      "jp": "……すみません。",
      "tr": "……Maaf."
     }
    ]
   },
   {
    "no": 2,
    "lines": [
     {
      "jp": "もう　12{時|じ}ですよ。　{一人|ひとり}で　{大丈夫|だいじょうぶ}ですか。",
      "tr": "Sudah pukul dua belas. Tidak apa-apa kalau sendirian?"
     },
     {
      "jp": "……ええ、{心配|しんぱい}しないで　ください。　タクシーで　{帰|かえ}りますから。",
      "tr": "……Ya, jangan khawatir. Saya pulang dengan taksi."
     }
    ]
   },
   {
    "no": 3,
    "lines": [
     {
      "jp": "{今晩|こんばん}　{飲|の}みに　{行|い}きませんか。",
      "tr": "Bagaimana kalau nanti malam pergi minum minuman keras?"
     },
     {
      "jp": "……すみません。　あしたから　ホンコンへ　{出張|しゅっちょう}しなければ　なりません。　ですから、{早|はや}く　{帰|かえ}ります。",
      "tr": "……Maaf. Saya harus dinas ke Hong Kong besok. Karena itu, saya cepat pulang."
     }
    ]
   },
   {
    "no": 4,
    "lines": [
     {
      "jp": "{子|こ}どもも　お{金|かね}を　{払|はら}わなければ　なりませんか。",
      "tr": "Apakah anak juga harus bayar?"
     },
     {
      "jp": "……いいえ、{払|はら}わなくても　いいです。",
      "tr": "……Tidak, tidak usah bayar."
     }
    ]
   },
   {
    "no": 5,
    "lines": [
     {
      "jp": "レポートは　いつまでに　{出|だ}さなければ　なりませんか。",
      "tr": "Sampai dengan kapan laporan harus diserahkan?"
     },
     {
      "jp": "……{金曜日|きんようび}までに　{出|だ}して　ください。",
      "tr": "……Tolong diserahkan sampai dengan hari Jumat."
     }
    ]
   }
  ],
  "kaiwa": {
   "title_jp": "どう　しましたか",
   "title_tr": "Kenapa?",
   "image": "img/L17/kaiwa.webp",
   "audio": "audio/L17_kaiwa.m4a",
   "cd_track": "CD60",
   "lines": [
    {
     "speaker_jp": "{医者|いしゃ}",
     "speaker_tr": "Dokter",
     "jp": "どう　しましたか。",
     "tr": "Kenapa?"
    },
    {
     "speaker_jp": "{松本|まつもと}",
     "speaker_tr": "Matsumoto",
     "jp": "きのうから　のどが　{痛|いた}くて、{熱|ねつ}も　{少|すこ}し　あります。",
     "tr": "Sejak kemarin sakit kerongkongan dan sedikit demam juga."
    },
    {
     "speaker_jp": "{医者|いしゃ}",
     "speaker_tr": "Dokter",
     "jp": "そうですか。　ちょっと　{口|くち}を　{開|あ}けて　ください。",
     "tr": "O, begitu. Coba buka mulut."
    },
    {
     "speaker_jp": "{医者|いしゃ}",
     "speaker_tr": "Dokter",
     "break_before": true,
     "jp": "かぜですね。　2、3{日|にち}　ゆっくり　{休|やす}んで　ください。",
     "tr": "Masuk angin ya. Beristirahat yang cukup selama dua, tiga hari."
    },
    {
     "speaker_jp": "{松本|まつもと}",
     "speaker_tr": "Matsumoto",
     "jp": "あのう、あしたから　{東京|とうきょう}へ　{出張|しゅっちょう}しなければ　なりません。",
     "tr": "Begini, Dok, mulai besok saya harus dinas ke Tokyo."
    },
    {
     "speaker_jp": "{医者|いしゃ}",
     "speaker_tr": "Dokter",
     "jp": "じゃ、きょうは　{薬|くすり}を　{飲|の}んで、{早|はや}く　{寝|ね}て　ください。",
     "tr": "Kalau begitu, hari ini minum obat, dan cepat istirahat."
    },
    {
     "speaker_jp": "{松本|まつもと}",
     "speaker_tr": "Matsumoto",
     "jp": "はい。",
     "tr": "Ya."
    },
    {
     "speaker_jp": "{医者|いしゃ}",
     "speaker_tr": "Dokter",
     "jp": "それから　{今晩|こんばん}は　おふろに　{入|はい}らないで　くださいね。",
     "tr": "Dan juga nanti malam jangan mandi, ya."
    },
    {
     "speaker_jp": "{松本|まつもと}",
     "speaker_tr": "Matsumoto",
     "jp": "はい、わかりました。",
     "tr": "Baik, saya mengerti."
    },
    {
     "speaker_jp": "{医者|いしゃ}",
     "speaker_tr": "Dokter",
     "jp": "じゃ、お{大事|だいじ}に。",
     "tr": "Semoga lekas sembuh."
    },
    {
     "speaker_jp": "{松本|まつもと}",
     "speaker_tr": "Matsumoto",
     "jp": "どうも　ありがとう　ございました。",
     "tr": "Terima kasih banyak."
    }
   ]
  },
