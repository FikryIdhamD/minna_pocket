    "bunpou": [
      { "no": 1, "title_rich": "これ／それ／あれ", "blocks": [
        { "type": "p", "text_rich": "これ, それ, あれ menunjukkan benda dan berfungsi sebagai Kata Benda." },
        { "type": "p", "text_rich": "これ menunjukkan benda yang ada di dekat si pembicara." },
        { "type": "p", "text_rich": "それ menunjukkan benda yang ada di dekat lawan bicara." },
        { "type": "p", "text_rich": "あれ menunjukkan benda yang ada jauh dari pembicara dan lawan bicara." },
        { "type": "ex", "mark": "①", "lines": [ { "jp": "それは　{辞書|じしょ}ですか。", "tr": "Apakah ini kamus?" } ] },
        { "type": "ex", "mark": "②", "lines": [ { "jp": "これは　だれの　{傘|かさ}ですか。", "tr": "Ini payung siapa?" } ] } ] },
      { "no": 2, "title_rich": "この Kata Benda／その Kata Benda／あの Kata Benda", "blocks": [
        { "type": "p", "text_rich": "Jika menerangkan Kata Benda, dipakai この, その dan あの." },
        { "type": "ex", "mark": "③", "lines": [ { "jp": "この　{本|ほん}は　わたしのです。", "tr": "Buku ini kepunyaan saya." } ] },
        { "type": "ex", "mark": "④", "lines": [ { "jp": "あの　{方|かた}は　どなたですか。", "tr": "Siapakah beliau?" } ] },
        { "type": "image", "image": "img/L02/bunpou_kosoado.webp", "caption": "これ・それ・あれ / この・その・あの かばん" } ] },
      { "no": 3, "title_rich": "そうです", "blocks": [
        { "type": "p", "text_rich": "Dalam kalimat nominal yang menanyakan positif atau negatif, sering digunakan そう terhadap jawaban positif, dan dapat menjawab dengan kalimat はい、そうです." },
        { "type": "ex", "mark": "⑤", "lines": [
          { "jp": "それは　{辞書|じしょ}ですか。", "tr": "Apakah itu kamus?" },
          { "jp": "……はい、そうです。", "tr": "……Ya, betul." } ] },
        { "type": "p", "text_rich": "Untuk bentuk negatif, tidak lazim menjawab dengan そう, tetapi sebagai gantinya digunakan ちがいます (bukan), atau menyatakan jawaban yang sebenarnya." },
        { "type": "ex", "mark": "⑥", "lines": [
          { "jp": "それは　ミラーさんのですか。", "tr": "Apakah itu punya Sdr. Miller?" },
          { "jp": "……いいえ、{違|ちが}います。", "tr": "……Bukan." } ] },
        { "type": "ex", "mark": "⑦", "lines": [
          { "jp": "それは　シャープペンシルですか。", "tr": "Apakah itu pensil isi ulang?" },
          { "jp": "……いいえ、ボールペンです。", "tr": "……Bukan, bolpoin." } ] } ] },
      { "no": 4, "title_rich": "～か、～か", "blocks": [
        { "type": "p", "text_rich": "Dengan kalimat tanya ini memberi pilihan yang lebih dari dua, kemudian lawan bicara memilih yang benar. Untuk jawaban, tidak dibubuhi はい、いいえ, tetapi menyatakan langsung kalimat yang dipilih." },
        { "type": "ex", "mark": "⑧", "lines": [
          { "jp": "これは　「9」ですか、「7」ですか。", "tr": "Apakah ini \"9\" atau \"7\"?" },
          { "jp": "……「9」です。", "tr": "……\"9\"." } ] } ] },
      { "no": 5, "title_rich": "Kata Benda₁ の Kata Benda₂", "blocks": [
        { "type": "p", "text_rich": "Pada Pelajaran 1 telah dipelajari bahwa jika Kata Benda₁ menerangkan Kata Benda₂, maka digunakan の di antara Kata Benda₁ dan Kata Benda₂. Pada pelajaran ini belajar cara penggunaan の sebagai berikut di bawah ini:" },
        { "type": "h", "text_rich": "1) Kata Benda₁ menerangkan sesuatu dari Kata Benda₂." },
        { "type": "ex", "mark": "⑨", "lines": [ { "jp": "これは　コンピューターの　{本|ほん}です。", "tr": "Ini buku komputer." } ] },
        { "type": "h", "text_rich": "2) Kata Benda₁ menyatakan pemilik Kata Benda₂." },
        { "type": "ex", "mark": "⑩", "lines": [ { "jp": "これは　わたしの　{本|ほん}です。", "tr": "Ini buku saya." } ] } ] },
      { "no": 6, "title_rich": "の yang berfungsi sebagai pengganti Kata Benda", "blocks": [
        { "type": "p", "text_rich": "の ini digunakan untuk mengganti Kata Benda yang terdapat sebelumnya (かばん pada contoh ⑪). Seperti contoh ⑪, jika diletakkan di belakang Kata Benda (さとうさん), maka bentuk kalimat menjadi sama maknanya dengan dihilangkannya Kata Benda₂ dari kalimat Kata Benda₁ の Kata Benda₂ (さとうさんの かばん). の digunakan sebagai pengganti kata benda, tetapi tidak digunakan sebagai pengganti orang." },
        { "type": "ex", "mark": "⑪", "lines": [
          { "jp": "あれは　だれの　かばんですか。", "tr": "Itu tas siapa?" },
          { "jp": "……{佐藤|さとう}さんのです。", "tr": "……Kepunyaan Sdr. Sato." } ] },
        { "type": "ex", "mark": "⑫", "lines": [
          { "jp": "この　かばんは　あなたのですか。", "tr": "Apakah tas ini tas Anda?" },
          { "jp": "……いいえ、わたしのじゃ　ありません。", "tr": "……Bukan, bukan kepunyaan saya." } ] },
        { "type": "ex", "mark": "⑬", "lines": [
          { "jp": "ミラーさんは　IMCの　{社員|しゃいん}ですか。", "tr": "Apakah Sdr. Miller pegawai perusahaan IMC?" },
          { "jp": "……はい、IMCの　{社員|しゃいん}です。", "tr": "……Ya, pegawai perusahaan IMC." },
          { "jp": "×　はい、IMCのです。" } ] } ] },
      { "no": 7, "title_rich": "お～", "blocks": [
        { "type": "p", "text_rich": "お dibubuhkan pada Kata Benda dan berfungsi untuk menyatakan kesopanan." },
        { "type": "p", "text_rich": "(Contoh: ［お］みやげ, ［お］さけ)" } ] },
      { "no": 8, "title_rich": "そうですか", "blocks": [
        { "type": "p", "text_rich": "Ketika mendapatkan informasi baru, ekspresi ini digunakan untuk menyatakan telah mengerti. Diucapkan dengan intonasi menurun." },
        { "type": "ex", "mark": "⑭", "lines": [
          { "jp": "この　{傘|かさ}は　あなたのですか。", "tr": "Apakah payung ini punya Anda?" },
          { "jp": "……いいえ、{違|ちが}います。シュミットさんのです。", "tr": "……Bukan, salah. Punya Sdr. Schmidt." },
          { "jp": "そうですか。", "tr": "O, begitu." } ] } ] }
    ],

