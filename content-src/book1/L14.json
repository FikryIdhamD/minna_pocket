  "reibun": [
   {
    "no": 1,
    "lines": [
     {
      "jp": "ボールペンで　{名前|なまえ}を　{書|か}いて　ください。",
      "tr": "Tolong tuliskan nama dengan bolpoin."
     },
     {
      "jp": "……はい、わかりました。",
      "tr": "……Baik."
     }
    ]
   },
   {
    "no": 2,
    "lines": [
     {
      "jp": "すみませんが、この　{漢字|かんじ}の　{読|よ}み{方|かた}を　{教|おし}えて　ください。",
      "tr": "Permisi, tolong ajarkan cara membaca Kanji ini."
     },
     {
      "jp": "……「じゅうしょ」ですよ。",
      "tr": "……Itu “Jusho”."
     }
    ]
   },
   {
    "no": 3,
    "lines": [
     {
      "jp": "{暑|あつ}いですね。　{窓|まど}を　{開|あ}けましょうか。",
      "tr": "Panas, ya. Bagaimana kalau saya membuka jendela?"
     },
     {
      "jp": "……すみません。　お{願|ねが}いします。",
      "tr": "……Maaf. Tolong!"
     }
    ]
   },
   {
    "no": 4,
    "lines": [
     {
      "jp": "{駅|えき}まで　{迎|むか}えに　{行|い}きましょうか。",
      "tr": "Bagaimana kalau saya pergi menjemput di stasiun?"
     },
     {
      "jp": "……タクシーで　{行|い}きますから、けっこうです。",
      "tr": "……Tidak, terima kasih, karena saya pergi dengan taksi."
     }
    ]
   },
   {
    "no": 5,
    "lines": [
     {
      "jp": "{佐藤|さとう}さんは　どこですか。",
      "tr": "Di mana Sdr. Sato?"
     },
     {
      "jp": "……{今|いま}　{会議室|かいぎしつ}で　{松本|まつもと}さんと　{話|はな}して　います。",
      "tr": "……Sekarang sedang berbicara dengan Sdr. Matsumoto di ruang rapat."
     },
     {
      "jp": "じゃ、また　あとで　{来|き}ます。",
      "tr": "Kalau begitu, sebentar lagi saya datang."
     }
    ]
   },
   {
    "no": 6,
    "lines": [
     {
      "jp": "{雨|あめ}が　{降|ふ}って　いますか。",
      "tr": "Apakah turun hujan?"
     },
     {
      "jp": "……いいえ、{降|ふ}って　いません。",
      "tr": "……Tidak, tidak turun hujan."
     }
    ]
   }
